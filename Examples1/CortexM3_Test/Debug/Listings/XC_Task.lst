L 23 "..\..\code\include\XC_Task.h" 2
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 函数声明-[用户]基本任务操作 */
N
N/**
N * @brief       [用户]任务注册
N * @param[in]   phXCOS  框架句柄
N * @param[in]   phTCB   协程任务控制块
N * @param[in]   fTask   任务的函数指针(任务入口)
N * @param[in]   pParam  传递给任务的参数
N * @return      XC_Retuen_t
N * @retval      XC_OK :      注册成功
N * @retval      XC_FAIL :    注册失败,任务太多
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  **不可多次注册同个任务(没有做重复判断,会发生未知情况)**
N */
NXC_Retuen_t XCTask_Reg(XC_OSHandle_t phXCOS, XC_TaskHandle_t phTCB, void (*fTask)(XC_TaskHandle_t), void* pParam);
N
N/**
N * @brief       [用户]任务移除
N * @param[in]   phTCB 协程控制块
N * @details
N *  **不可在中断中使用(有链表操作)**
N */
Nvoid XCTask_Remove(XC_TaskHandle_t phTCB);
N
N/**
N * @brief       [用户]任务复位
N * @param[in]   phTCB   协程控制块
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  **不可复位自身(复位自身使用"XC_Reset")**
N */
Nvoid XCTask_Reset(XC_TaskHandle_t phTCB);
N
N/************************************************ 我是分割线 ************************************************/
N/** 函数声明-[用户]任务分步创建相关的用户函数 */
N
N/**
N * @brief       [用户]设置任务入口
N * @param[in]   phTCB   协程任务控制块
N * @param[in]   fTask   任务的函数指针(任务入口)
N * @param[in]   pParam  传递给任务的参数
N * @details
N *  **不可在中断中使用**
N *  只设置任务入口和传递给任务的参数;
N *  一般配合XCTask_Addk"使用;
N */
Nvoid XCTask_SetEntry(XC_TaskHandle_t phTCB, void (*fTask)(XC_TaskHandle_t), void* pParam);
N
N/**
N * @brief   [用户]添加任务
N * @param   phXCOS  框架句柄
N * @param   phTCB   协程任务控制块
N * @return  XC_Retuen_t
N * @retval  XC_OK :      注册成功
N * @retval  XC_FAIL :    注册失败,任务太多
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  添加的任务必须先调用"XCTask_SetEntry";
N *  设置好任务入口和传递的参数才可添加;
N */
NXC_Retuen_t XCTask_Add(XC_OSHandle_t phXCOS, XC_TaskHandle_t phTCB);
N
N/************************************************ 我是分割线 ************************************************/
N/** 函数声明-[用户]通知 | 挂起 | 挂起恢复 */
N
N/**
N * @brief       [用户]发送通知(void*)
N * @param[in]   phTCB       任务控制块
N * @param[in]   pNotifyData 通知传递的数据(void*)类型
N * @return      XC_Retuen_t
N * @retval      XC_OK :          通知成功
N * @retval      XC_CONTINUE :    任务已经唤醒(已在就绪表)
N * @retval      XC_FAIL :        任务被挂起
N * @details     发送通知,唤醒任务;
N */
NXC_Retuen_t XCTask_NotifySend(XC_TaskHandle_t phTCB, void* pNotifyData);
N
N/**
N * @brief       [用户]任务挂起
N * @param[in]   phTCB   任务控制块
N * @return      XC_Retuen_t
N * @retval      XC_OK :          挂起成功
N * @retval      XC_CONTINUE :    已经被挂起
N * @details
N *  **可在中断中调用**
N *  将任务挂起,本次任务运行完成后暂停任务;
N */
NXC_Retuen_t XCTask_Suspend(XC_TaskHandle_t phTCB);
N
N/**
N * @brief       [用户]任务挂起恢复
N * @param[in]   phTCB   任务控制块
N * @return      XC_Retuen_t
N * @retval      XC_OK :          恢复成功
N * @retval      XC_CONTINUE :    任务没有挂起
N * @details
N *  **可在中断中调用**
N *  只能恢复被挂起的任务;
N */
NXC_Retuen_t XCTask_Resume(XC_TaskHandle_t phTCB);
N
N/************************************************ 我是分割线 ************************************************/
N/** 以下是函数宏 */
N
N/**
N * @brief       [用户]获取任务注册时传递的参数(void*)
N * @return      void*   返回空指针类型数据;
N * @details
N *  **任意位置可调用;**
N *  用来获取任务参数;
N *  > 注意: 因为协程内上下文切换局部变量是不保存的,
N *  > 所以若是要使用传递的参数需要再"XC_Enter"前将参数赋值给变量;
N */
N#define XCTask_GetParam(_phTCB_) ((_phTCB_)->pParam)
N
N/**
N * @brief       [用户]获取任务运行状态
N * @param[in]   _phTCB_  [XC_TaskHandle_t]任务控制块
N * @return      XC_TaskState_t
N * @retval      XC_TASK_VOID :          空,被移除后的状态
N * @retval      XC_TASK_RUN :           运行
N * @retval      XC_TASK_READY :         就绪(注册后的状态)
N * @retval      XC_TASK_DELAY :         [阻塞]延时
N * @retval      XC_TASK_WAIT_NOTIFY :   [阻塞]等待通知
N * @retval      XC_TASK_SUSPEND :       [阻塞]挂起
N * @details     说明
N *  **任意位置可调用;**
N *  获取任务运行的状态;
N */
N#define XCTask_GetState(_phTCB_) ((_phTCB_)->TaskState)
N
N/**
N * @brief       [用户]更新通知数据(void*)
N * @param[in]   _phTCB_          [XC_TaskHandle_t]任务控制块
N * @param[in]   _pNotifyData    [void*]通知数据
N * @details
N *  **任意位置可调用;**
N *  在不使用任务通知的时候,可以用通知数据来传递数据;
N *  此函数用于更新(写)通知数据;
N */
N#define XCTask_UpdateNotifyData(_phTCB_, _pNotifyData) \
N    {                                                  \
N        (_phTCB_)->pNotifyData = (_pNotifyData);       \
N    }
X#define XCTask_UpdateNotifyData(_phTCB_, _pNotifyData)     {                                                          (_phTCB_)->pNotifyData = (_pNotifyData);           }
N
N/**
N * @brief       [用户]读取通知数据(void*)
N * @param[in]   _phTCB_  [XC_TaskHandle_t]任务控制块
N * @return      void*   返回通知数据
N * @details
N *  **任意位置可调用;**
N *  在不使用任务通知的时候,可以用通知数据来传递数据;
N *  此函数用于读取通知数据;
N */
N#define XCTask_ReadNotifyData(_phTCB_) ((_phTCB_)->pNotifyData)
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 协程块:开始/结束 */
N
N/**
N * @brief       [用户][协程]进入
N * @param[in]   _phTCB_  [XC_TaskHandle_t]任务控制块
N * @details
N *  **协程块的开始;**
N *  必须搭配"XC_Leave"使用;
N */
N#define XC_Enter(_phTCB_)                                        \
N    {                                                            \
N        /*全局变量转局部变量可加快运行速度*/                     \
N        XC_TaskHandle_t _phXCTCB_ = (_phTCB_);      /*得到PCB*/  \
N        XCBP_t*         _pXCPB_   = &_phXCTCB_->BP; /*得到断点*/ \
N        /*启动协程*/                                             \
N        _COR_Start(*_pXCPB_); /*启动*/
X#define XC_Enter(_phTCB_)                                            {                                                                                                  XC_TaskHandle_t _phXCTCB_ = (_phTCB_);                 XCBP_t*         _pXCPB_   = &_phXCTCB_->BP;                                                                 _COR_Start(*_pXCPB_);  
N
N/**
N * @brief       [用户][协程]离开
N * @details
N *  **协程块的结束;**
N *  必须搭配"XC_Enter"使用;
N */
N#define XC_Leave()       \
N    _COR_End(); /*结束*/ \
N    }
X#define XC_Leave()           _COR_End();       }
N
N/************************************************ 我是分割线 ************************************************/
N/** 协程块:协程控制,必须在协程块中调用 */
N
N/**
N * @brief       [用户][协程]让出控制
N * @details
N *  **必须在协程块中使用;**
N *  让出CPU的使用权,跳出协程,下次调度后从此处继续处理;
N */
N#define XC_Yield()                                               \
N    {                                                            \
N        _phXCTCB_->TaskState = XC_TASK_READY; /*任务状态:就绪*/  \
N        _COR_SetBPBreak(*_pXCPB_)             /*设置断点并跳出*/ \
N    }
X#define XC_Yield()                                                   {                                                                    _phXCTCB_->TaskState = XC_TASK_READY;            _COR_SetBPBreak(*_pXCPB_)                   }
N
N/**
N * @brief       [用户][协程]任务复位
N * @details
N *  **必须在协程块中使用;**
N *  复位当前在运行的任务;运行此宏后将立刻退出协程块
N */
N#define XC_Reset()               \
N    {                            \
N        XCTask_Reset(_phXCTCB_); \
N        _COR_Break(*_pXCPB_);    \
N    }
X#define XC_Reset()                   {                                    XCTask_Reset(_phXCTCB_);         _COR_Break(*_pXCPB_);        }
N
N/**
N * @brief       [用户][协程]协程块内获取任务注册时传递的参数(void*)
N * @return      void*   返回空指针类型数据;
N * @details
N *  **必须在协程块中使用;**
N *  用来获取参数;
N *  > 注意: 因为协程内上下文切换局部变量是不保存的,
N *  > 所以若是要使用传递的参数需要再"XC_Enter"前将参数赋值给变量;
N */
N#define XC_GetParam() (_phXCTCB_->pParam)
N
N/**
N * @brief       [用户][协程]将自身挂起
N * @details
N *  必须在协程块中使用;
N *  将自身挂起;
N */
N#define XC_Suspend()                                  \
N    {                                                 \
N        XCTask_Suspend(_phXCTCB_); /*任务挂起*/       \
N        _COR_SetBPBreak(*_pXCPB_); /*设置断点并跳出*/ \
N    }
X#define XC_Suspend()                                      {                                                         XCTask_Suspend(_phXCTCB_);                 _COR_SetBPBreak(*_pXCPB_);       }
N
N/**
N * @brief   [用户][协程]获取唤醒类型
N * @return  uint8_t   唤醒的类型,返回"XC_WakeType_t"类型数据;
N * @details
N *  必须在协程块中使用;
N *  在任务等待通知,延时,挂起等操作唤醒后确定唤醒源是什么;
N *  注意,唤醒源不会被清除,直到下次唤醒;
N */
N#define XC_GetWakeType() (_phXCTCB_->WakeType)
N
N/**
N * @brief   [用户][协程]移除自身
N * @details
N *  必须在协程块中使用;
N *  将自身移除;
N *  注意,唤醒源不会被清除,直到下次唤醒;
N */
N#define XC_Remove()                            \
N    {                                          \
N        XCTask_Remove(_phXCTCB_); /*移除任务*/ \
N        _COR_Break(*_pXCPB_);     /*直接跳出*/ \
N    }
X#define XC_Remove()                                {                                                  XCTask_Remove(_phXCTCB_);           _COR_Break(*_pXCPB_);           }
N
N/************************************************ 我是分割线 ************************************************/
N/** 协程块:延时处理,必须在协程块中调用 */
N
N/**
N * @brief       [用户][协程]延时n个Tick
N * @param[in]   _n  [XC_Tick_t]延时的值
N * @details
N *  **必须在协程块中使用;**
N *  让出CPU的使用权,延时_n个基础时钟;
N */
N#define XC_DelayTick(_n)                                            \
N    {                                                               \
N        _phXCTCB_->TaskState    = XC_TASK_DELAY; /*任务状态:延时*/  \
N        _phXCTCB_->WakeType     = XC_WAKE_NONE;  /*清唤醒类型*/     \
N        _phXCTCB_->TaskWakeTick = (_n);          /*保存时间*/       \
N        _COR_SetBPBreak(*_pXCPB_);               /*设置断点并跳出*/ \
N    }
X#define XC_DelayTick(_n)                                                {                                                                       _phXCTCB_->TaskState    = XC_TASK_DELAY;            _phXCTCB_->WakeType     = XC_WAKE_NONE;                _phXCTCB_->TaskWakeTick = (_n);                          _COR_SetBPBreak(*_pXCPB_);                     }
N
N/**
N * @brief       [用户][协程]延时us
N * @param[in]   _n  [XC_Tick_t]延时的值
N * @details
N *  **必须在协程块中使用;**
N *  让出CPU的使用权,延时_n个时间;
N *  > 注意:us延时必须要Tick计数在us时基上才能准确的调用;
N */
N#define XC_DelayUs(_n)  XC_DelayTick(XCTime_UsToTicks(_n))
N
N/**
N * @brief       [用户][协程]延时ms
N * @param[in]   _n  [XC_Tick_t]延时的值
N * @details
N *  **必须在协程块中使用;**
N *  让出CPU的使用权,延时_n个时间;
N */
N#define XC_DelayMs(_n)  XC_DelayTick(XCTime_MsToTicks(_n))
N
N/**
N * @brief       [用户][协程]延时s
N * @param[in]   _n  [XC_Tick_t]延时的值
N * @details
N *  **必须在协程块中使用;**
N *  让出CPU的使用权,延时_n个时间;
N */
N#define XC_DelaySec(_n) XC_DelayTick(XCTime_SecToTicks(_n))
N
N/************************************************ 我是分割线 ************************************************/
N/** 协程块:任务通知处理,必须在协程块中调用 */
N
N/**
N * @brief       [用户][协程]等待通知(单位:系统Tick)
N * @param[in]   _TickTimeout    [XC_Tick_t]超时时间,单位:系统Tick;注意:若参数为0则死等;
N * @details
N *  **必须在协程块中使用;**
N *  任务等待通知;
N *  唤醒后用"XC_GetNotifyWakeState"判断是否超时;
N *  注意:"TaskState"任务状态参数需要最先改变,防止出现临界段;
N */
N#define XC_WaitNotify(_TickTimeout)                                          \
N    {                                                                        \
N        _phXCTCB_->TaskState    = XC_TASK_WAIT_NOTIFY; /*任务状态:等待通知*/ \
N        _phXCTCB_->WakeType     = XC_WAKE_NONE;        /*唤醒类型:无唤醒*/   \
N        _phXCTCB_->TaskWakeTick = (_TickTimeout);      /*超时的时间*/        \
N        _COR_SetBPBreak(*_pXCPB_);                     /*设置断点并跳出*/    \
N    }
X#define XC_WaitNotify(_TickTimeout)                                              {                                                                                _phXCTCB_->TaskState    = XC_TASK_WAIT_NOTIFY;           _phXCTCB_->WakeType     = XC_WAKE_NONE;                    _phXCTCB_->TaskWakeTick = (_TickTimeout);                       _COR_SetBPBreak(*_pXCPB_);                              }
N
N/**
N * @brief       [用户][协程]等待通知(单位:ms)
N * @param[in]   _msTimeout  [XC_Tick_t]超时时间,单位:ms;注意:若参数为0则死等;
N * @details
N *  **必须在协程块中使用;**
N *  任务等待通知;
N *  唤醒后用"XC_GetNotifyWakeState"判断是否超时;
N */
N#define XC_WaitNotifyMs(_msTimeout) XC_WaitNotify(XCTime_MsToTicks(_msTimeout))
N
N/**
N * @brief       [用户][协程]获取通知唤醒状态
N * @return      boot
N * @retval      0 : 没有超时
N * @retval      1 : 超时
N * @details
N *  **必须在协程块中使用;**
N *  用于判断任务通知阻塞唤醒后是否超时;
N *  > 通知函数:XC_WaitNotify
N */
N#define XC_GetNotifyWakeState()     (_phXCTCB_->WakeType != XC_WAKE_NOTIFY)
N
N/**
N * @brief       [用户][协程]获取通知的数据(void*)
N * @return      void*   返回通知数据
N * @details
N *  **必须在协程块中使用;**
N *  被通知唤醒后获取通知传递的数据;
N */
N#define XC_GetNotifyData()          (_phXCTCB_->pNotifyData)
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
N#endif
L 18 "..\..\Code\XC_Task.c" 2
N#include "Internal/XC_Internal.h"
L 1 "..\..\code\include\Internal/XC_Internal.h" 1
N/**
N * @file        XC_Internal.h
N * @brief       内部实现
N * @author      libertyzx (libertyzx@163.com)
N * @version     2.00
N * @date        2025/11/26
N * **********************************************
N * @copyright   Copyright (c) 2024 libertyzx. All rights reserved.
N * @license     This project is released under the MIT License.
N * **********************************************
N * @details     框架内部实现的代码
N * **********************************************
N *  修改日志
N *  - 见"XC_UpdateInfo.md"的更新说明;
N */
N//=== 防重复定义
N#ifndef _XC_Internal_h_
N#define _XC_Internal_h_
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 调度器调度锁 */
N
N/**
N * @brief       [内部]锁
N * @param[in]   _phXCOS [XC_OSHandle_t]框架句柄(会强制转换"XCOS句柄指针"类型)
N * @details
N *  主要用来锁定任务切换(包括链表操作,状态切换),防止中断调用时资源竞争;
N */
N#define XCSch_Lock(_phXCOS)                   \
N    {                                         \
N        ((XC_OSHandle_t)(_phXCOS))->Lock = 1; \
N    }
X#define XCSch_Lock(_phXCOS)                       {                                                 ((XC_OSHandle_t)(_phXCOS))->Lock = 1;     }
N
N/**
N * @brief       [内部]解锁
N * @param[in]   _phXCOS [XC_OSHandle_t]框架句柄(会强制转换"XCOS句柄指针"类型)
N * @details
N *  主要用来锁定任务切换(包括链表操作,状态切换),防止中断调用时资源竞争;
N */
N#define XCSch_Unlock(_phXCOS)                 \
N    {                                         \
N        ((XC_OSHandle_t)(_phXCOS))->Lock = 0; \
N    }
X#define XCSch_Unlock(_phXCOS)                     {                                                 ((XC_OSHandle_t)(_phXCOS))->Lock = 0;     }
N
N/**
N * @brief       [内部]获取锁的状态
N * @param[in]   _phXCOS [XC_OSHandle_t]框架句柄(会强制转换"XCOS句柄指针"类型)
N * @return      uint8_t
N * @retval      0 : 解锁
N * @retval      1 : 锁定
N * @details
N *  主要用来锁定任务切换(包括链表操作,状态切换),防止中断调用时资源竞争;
N */
N#define XCSch_GetLockState(_phXCOS)          (((XC_OSHandle_t)(_phXCOS))->Lock)
N
N/************************************************ 我是分割线 ************************************************/
N
N/** 任务链表节点处理 */
N
N/**
N * @brief       [内部]将任务移动到就绪表
N * @param[in]   phTCB   [XC_TaskHandle_t]协程控制块
N * @details
N *  将任务移动到下个就绪节点前,确保最后调用;
N */
N#define XCTask_MoveTaskToReadyList(_phTCB)   XCList_MoveNodeBefore((_phTCB)->phXCOS->pNextReadyNode, &(_phTCB)->ListNode);
N
N/**
N * @brief       [内部]将任务移动到阻塞表
N * @param[in]   phTCB   [XC_TaskHandle_t]协程控制块
N * @details
N *  将任务移动到阻塞表尾部;
N */
N#define XCTask_MoveTaskToBlockedList(_phTCB) XCList_MoveNodeBefore(&(_phTCB)->phXCOS->BlockedList, &(_phTCB)->ListNode);
N
N/**
N * @brief       [内部]移除任务节点
N * @param[in]   phTCB   [XC_TaskHandle_t]协程控制块
N * @return      void
N * @details
N *  从XCOS中删除TCB节点;
N */
N#define XCTask_RemoveTaskNode(_phTCB)        XCList_Remove(&(_phTCB)->ListNode);
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
