N/** 枚举类型 */
N
N/**
N * @brief   [用户]函数返回值
N */
Ntypedef enum {
N    XC_FAIL = -1, // 失败
N    XC_OK   = 0,  // 成功
N    XC_CONTINUE,  // 继续
N} XC_Retuen_t;
N
N/**
N * @brief   [用户]任务状态值(当前协程状态)
N */
Ntypedef enum {
N    XC_TASK_VOID = 0, // 空,被移除后的状态
N    XC_TASK_RUN,      // 运行
N    XC_TASK_READY,    // 就绪(注册后的状态)
N    XC_TASK_SUSPEND,  // [阻塞]挂起
N    /** 延时和等待通知会在代码中比较,所以要放在最后 */
N    XC_TASK_DELAY,       // [阻塞]延时
N    XC_TASK_WAIT_NOTIFY, // [阻塞]等待通知
N} XC_TaskState_t;
N
N/**
N * @brief   [用户]唤醒状态
N * @details
N *  注意,这里"XC_WAKE_NOTIFY"做了特殊化,固定0;
N *  因为在调用通知唤醒状态时会判断"XC_WAKE_NOTIFY",
N *  此配置为0时,编译器编译"Cortex-M*"编译优化小于"-O3"时可减少存储占用;
N */
Ntypedef enum {
N    XC_WAKE_NONE   = 1, // 无唤醒
N    XC_WAKE_TIME   = 2, // 时间到达唤醒
N    XC_WAKE_NOTIFY = 0, // 通知到达唤醒
N    XC_WAKE_RESUME = 3, // 任务挂起后恢复
N} XC_WakeType_t;
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 基础类型 */
N
N/**
N * @brief   [用户]XCOS基础数据类型
N * @details
N *  默认32位,用于系统滴答计数的数据
N *  一般不用改
N */
N/** "XC_Tick_t"在"XC_Config.h"文件定义 */
N
N/**
N * [用户]软件定时器计数类型
N */
Ntypedef struct {
