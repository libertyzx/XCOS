N/** 协程底层实现("ANSI-C"和"GNU-C"区分) */
N#ifdef __GNUC__
N#include "Internal/XC_CorGNU.h" //运行"GNU-C"库
L 1 "..\..\code\include\Internal/XC_CorGNU.h" 1
N/**
N * @file        XC_CorGNU.h
N * @brief       协程库(GNU-C实现)
N * @author      libertyzx (libertyzx@163.com)
N * @version     0.4
N * @date        2025/09/24
N * **********************************************
N * @copyright   Copyright (c) 2018 libertyzx. All rights reserved.
N * @license     This project is released under the MIT License.
N * **********************************************
N * @details
N *  在GUN环境下,使用"goto label"来实现协程;
N *  goto标签由"__func__"和"__LINE__"组合而成, 断点直接获取标签地址;
N *  使用"goto *标签地址"即可跳转到指定标签;
N *  使用协程库后,每个文件代码行数不能超过65535;
N * **********************************************
N *  修改日志
N *  - 2018/04/16
N *      - 版本:0.1
N *      - 初始编写
N *  - 2022/08/15
N *      - 版本:0.2
N *      - 修改断点在断点标号前加'_',为了防止数字开头的文件,导致标号不符合c语言规范;
N *      - "_COR_End"添加goto结束断点;
N *  - 2023/12/21
N *      - 版本:0.3
N *      - 增加"_COR_Break"直接跳出协程;
N *  - 2024/03/23
N *      - 版本:0.4
N *      - 删除宏中的"do{}while(0)"操作;
N */
N//=== 防重复定义
N#ifndef _XC_CorGNU_h_
N#define _XC_CorGNU_h_
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 数据类型 */
N
N/**
N * @brief       协程断点类型
N * @details     用于保存断点的地址;
N */
Ntypedef void* COR_BP_t;
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 协程实现 */
N
N//=== 基础函数宏 ==============================================================|
N
N/**
N * @brief       [私有]协程-组合断点标志
N * @param[in]   S1  [字符]goto标签前缀
N * @param[in]   S1  [字符]goto标签后缀
N * @details
N *  使用了"##"字符连接符,所以展开需要2次才能得到标签;
N */
N#define _COR_BP2(S1, S2) _##S1##S2
N#define _COR_BP(S1, S2)  _COR_BP2(S1, S2)
N
N/**
N * @brief       协程-断点初始化
N * @param[in]   BP  [COR_BP_t]协程断点
N * @details     初始化断点;
N */
N#define _COR_Init(BP)    ((BP) = NULL)
N
N/**
N * @brief       协程-代码开头
N * @param[in]   BP  [COR_BP_t]协程断点
N * @details     协程块的开始(状态机的开始);
N */
N#define _COR_Start(BP)   \
N    {                    \
N        if(BP != NULL) { \
N            goto* BP;    \
N        }                \
N    }
X#define _COR_Start(BP)       {                            if(BP != NULL) {             goto* BP;            }                    }
N
N/**
N * @brief       协程-设置断点
N * @param[in]   BP  [COR_BP_t]协程断点
N * @details     保存当前行的标签地址;
N */
N#define _COR_SetBP(BP)                        \
N    {                                         \
N        /*保存并设置断点(函数名+行号)*/       \
N        (BP) = &&_COR_BP(__func__, __LINE__); \
N        _COR_BP(__func__, __LINE__) :;        \
N    }
X#define _COR_SetBP(BP)                            {                                                                 (BP) = &&_COR_BP(__func__, __LINE__);         _COR_BP(__func__, __LINE__) :;            }
N
N/**
N * @brief       协程-跳出
N * @param[in]   BP  [COR_BP_t]协程断点
N * @details     直接跳出协程
N */
N#define _COR_Break(BP) \
N    goto _XCCOR_GOTO_End;
X#define _COR_Break(BP)     goto _XCCOR_GOTO_End;
N
N/**
N * @brief       协程-设置断点并跳出
N * @param[in]   BP  [COR_BP_t]协程断点
N * @details     保存当前行的标签地址,然后跳出;
N */
N#define _COR_SetBPBreak(BP)                     \
N    {                                           \
N        /*保存并设置断点(函数名+行号)然后跳出*/ \
N        (BP) = &&_COR_BP(__func__, __LINE__);   \
N        goto _XCCOR_GOTO_End;                   \
N        _COR_BP(__func__, __LINE__) :;          \
N    }
X#define _COR_SetBPBreak(BP)                         {                                                             (BP) = &&_COR_BP(__func__, __LINE__);           goto _XCCOR_GOTO_End;                           _COR_BP(__func__, __LINE__) :;              }
N
N/**
N * @brief       协程-代码结束
N * @details     协程块的结束(状态机的结尾);
N */
N#define _COR_End() \
N    _XCCOR_GOTO_End: /*结束跳转标志*/
X#define _COR_End()     _XCCOR_GOTO_End:  
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
N#endif
L 32 "..\..\code\include\Internal/XC_TypeInternal.h" 2
N#else
S#include "Internal/XC_CorANSI.h" //运行"ANSI-C"库
N#endif
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 数据类型 */
N
N/**
N * @brief   [用户]XCOS句柄
N * @details
N *  用于记录XCOS实例的数据,一个工程中开源有多个XCOS实例,用此句柄区分;
N *  字节数说明(32bit): 8*4+4*2+4+4 = 48Byte
N */
Nstruct XCOS_t {
N    // 链表
N    XCListNode_t ReadyList;        // 就绪链表
N    XCListNode_t TimeList;         // 延时/超时/等待的链表
N    XCListNode_t TimeOverflowList; // 时间溢出的链表
N    XCListNode_t BlockedList;      // 阻塞链表
N
N    XCListNode_t* pNextReadyNode; // 下个就绪的节点,位于就绪表
N
N    XC_Tick_t PrevTick; // 上个Tick,用于判断Tick溢出,在时间处理中时间表更新时更新
X    uint32_t PrevTick; 
N
N    uint8_t TaskNum; // 任务数量
N    uint8_t Lock;    // 锁(1锁定;0解锁),用于中断处理
N
N    uint8_t TaskSchedTrigger;   // 任务调度触发(用于通知,挂起,恢复异步操作触发)
N    uint8_t TaskSchedProcessed; // 任务调度处理(用于通知,挂起,恢复异步操作触发后处理)
N    /**
N     * @brief       框架空闲处理回调
N     * @param[in]   phXCOS      [XC_OSHandle_t]框架句柄
N     * @param[in]   IdleTick    [XC_Tick_t]空闲的Tick值(空闲多少个Tick)
N     * @details
N     *  在此回调函数中处理空闲相关事宜;
N     *  当函数被调用时,必定没有任务是就绪的,框架是空闲的;
N     *  若是在空闲时休眠系统,则需配置系统在"IdleTick"后唤醒框架;
N     *  若是系统Tick计数也停止了则需要更新Tick值:
N     *  - 系统Tick是定时器中断计数运行的,可以使用以下方式更新:
N     *      ```
N     *      volatile XC_Tick_t Tick;
N     *      Tick = XCTime_GetTick() + IdleTick;
N     *      XCTime_TickSet(Tick)
N     *      ```
N     *  - 系统Tick是一个计数器,则计数器等于"XCTime_GetTick() + IdleTick";
N     */
N    void (*fIdle)(struct XCOS_t*, XC_Tick_t);
X    void (*fIdle)(struct XCOS_t*, uint32_t);
N};
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief   [内部]XCOS核心断点类型
N * @details 用于创建上下文切换的断点标记
N */
Ntypedef COR_BP_t XCBP_t;
N
N/**
N * @brief   [用户]协程任务控制块(Task Control Block)
N * @details
N *  用于记录任务控制相关的数据,每个任务都需要一个独立的TCB;
N *  类型占字节数(32bit): 8+4*6+4+3=39Byte,补齐占:40Byte
N */
Ntypedef struct XC_TaskCB_t {
N    XCListNode_t   ListNode;            // 链表节点
N    struct XCOS_t* phXCOS;              // 任务所属的框架句柄
N    void (*fTask)(struct XC_TaskCB_t*); // 函数运行入口(任务入口)
N    XC_Tick_t TaskWakeTick;             // 任务下个唤醒的时间(0则一直阻塞)
X    uint32_t TaskWakeTick;             
N    XCBP_t    BP;                       // 协程断点(Break Point)
N
N    void* pParam;      // 传递的参数
N    void* pNotifyData; // 通知数据
N
N    uint8_t WakeType;  // 任务唤醒的类型("XC_WakeType_t"类型数据),用于判断是谁唤醒或者超时;
N    uint8_t TaskState; // 任务状态("XC_TaskState_t"类型数据);
N
N    uint8_t NotifyTrigger;   // 通知触发
N    uint8_t NotifyProcessed; // 通知触发处理
N
N    /**
N     *  以下三个变量用于处理任务挂起恢复;
N     *  主要用于任务挂起和恢复的异步操作;
N     *  "StateChangeType"的值为"XC_TaskState_t"类型中的:
N     *  - "XC_TASK_VOID"    : 未挂起
N     *  - "XC_TASK_SUSPEND" : 挂起
N     */
N    uint8_t StateChangeTrigger;   // 状态改变触发
N    uint8_t StateChangeProcessed; // 状态改变处理
N    uint8_t StateChangeType;      // 最后一次改变的是什么状态(XC_TASK_SUSPEND/XC_TASK_VOID)
N} XC_TaskCB_t;
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
N#endif
