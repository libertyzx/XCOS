X    uint32_t WaitCount;
N} XC_TimerTick_t;
N
N/************************************************ 我是分割线 ************************************************/
N/** 框架使用 */
N
N/**
N * @brief   [用户]XCOS框架实例
N * @details
N *  用于记录XCOS实例的数据,一个工程中开源有多个XCOS实例,用此类型区分;
N *  字节数说明(32bit): 48Byte
N */
Ntypedef struct XCOS_t XCOS_t;
N
N/**
N * @brief   [用户]XCOS框架句柄
N * @details
N *  不透明指针;
N *  对外提供的框架句柄指针,指向框架实例
N */
Ntypedef XCOS_t* XC_OSHandle_t;
N
N/************************************************ 我是分割线 ************************************************/
N/** 任务控制块 */
N
N/**
N * @brief   [用户]协程任务控制块(Task Control Block)的实例
N * @details
N *  用于记录任务控制相关的数据,每个任务都需要一个独立的TCB;
N *  类型占字节数(32bit):40Byte
N */
Ntypedef struct XC_TaskCB_t XC_TaskCB_t;
N
N/**
N * @brief   [用户]任务句柄
N * @details
N *  不透明指针;
N *  对外提供的任务句柄指针,指向任务实例
N */
Ntypedef XC_TaskCB_t* XC_TaskHandle_t;
