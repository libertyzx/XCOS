N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 基础函数宏 */
N
N/**
N * @brief       [内部]将任务插入到就绪表
N * @param[in]   phTCB   [XC_TaskHandle_t]协程控制块
N * @details
N *  将任务插入下个就绪任务前,任务节点在就绪表;
N */
N#define XC_InsertTaskToReadyList(_phTCB) XCList_InsertNodeBefore((_phTCB)->phXCOS->pNextReadyNode, &(_phTCB)->ListNode)
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 基本操作函数 */
N
N/**
N * @brief       [私有]任务基本初始化
N * @param[in]   phTCB   任务控制块
N * @details
N *  用户不调用;
N *  "TCB"中以下数据不会被初始化:
N *      - "ListNode" :  链表节点
N *      - "phXCOS" :    任务所属的框架句柄
N *      - "fTask" :     任务入口
N *      - "pParam" :    传递给任务的参数
N *      - "TaskState" : 任务状态
N *  在任务注册,移除,复位,添加时调用
N */
Nstatic void XC_TaskBasicInit(XC_TaskHandle_t phTCB)
N{
N    phTCB->TaskWakeTick = ~0;          // 任务下个唤醒的时间
N    _COR_Init(phTCB->BP);              // 初始化断点
X    ((phTCB->BP) = 0);              
N    phTCB->pNotifyData = NULL;         // 通知数据清零
X    phTCB->pNotifyData = 0;         
N    phTCB->WakeType    = XC_WAKE_NONE; // 没有唤醒
N
N    phTCB->NotifyTrigger   = 0; // 通知触发
N    phTCB->NotifyProcessed = 0; // 通知触发处理
N
N    phTCB->StateChangeTrigger   = 0;            // 状态改变触发
N    phTCB->StateChangeProcessed = 0;            // 状态改变处理
N    phTCB->StateChangeType      = XC_TASK_VOID; // 最后一次改变的是什么状态(XC_TASK_SUSPEND/XC_TASK_VOID)
N}
N
N/************************************************ 我是分割线 ************************************************/
N/** 任务链表节点处理 */
N
N/**
N * @brief       [内部]将任务插入到时间表
N * @param[in]   pList   需插入的链表(TimeList | TimeOverflowList)
N * @param[in]   phTCB   协程控制块
N * @details
N *  插入的节点需确保纯净,此函数不会处理插入节点的上下的连接;
N *  插入时间表按升序排列;
N *  从根节点向下(Next)查询"任务下个唤醒的时间"(TaskWakeTick),根据查询值从小到大排列;
N *  > 注意:若查询值相同,新节点插入在旧节点的前面;
N */
Nvoid XCTask_InsertTaskToTimeList(XCListNode_t* pList, XC_TaskHandle_t phTCB)
N{
N    XCListNode_t* pIterator;
N    XC_Tick_t     MaxTick = ~0; // Tick最大的值
X    uint32_t     MaxTick = ~0; 
N
N    if(MaxTick == phTCB->TaskWakeTick) {
N        pIterator = pList; // 若是唤醒值等于最大值,则迭代器设置为根节点
N    }
N    else {                                                                           // 查找(小->大)
N        pIterator = pList->pNext;                                                    // 获取根节点的下个节点地址
N        while((pIterator != pList) &&                                                // 指向节点不是根节点
N              (((XC_TaskHandle_t)pIterator)->TaskWakeTick <= phTCB->TaskWakeTick)) { // 指向节点的值小于新节点的值
N            pIterator = pIterator->pNext;                                            // 指向下个节点
N        }
N    }
N    XCList_InsertNodeBefore(pIterator, &phTCB->ListNode); // 插入节点,在"pIterator"之前
N}
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 任务相关的用户函数 */
N
N/**
N * @brief       [用户]任务注册
N * @param[in]   phXCOS  框架句柄
N * @param[in]   phTCB   协程任务控制块
N * @param[in]   fTask   任务的函数指针(任务入口)
N * @param[in]   pParam  传递给任务的参数
N * @return      XC_Retuen_t
N * @retval      XC_OK :      注册成功
N * @retval      XC_FAIL :    注册失败,任务太多
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  **不可多次注册同个任务(没有做重复判断,会发生未知错误)**
N *  任务注册完成后会挂载到就绪表;
N */
NXC_Retuen_t XCTask_Reg(XC_OSHandle_t phXCOS, XC_TaskHandle_t phTCB, void (*fTask)(XC_TaskHandle_t), void* pParam)
N{
N    if(phXCOS->TaskNum >= XC_CFG_MAX_TASKS) {
X    if(phXCOS->TaskNum >= (100)) {
N        return (XC_FAIL);
N    }
N
N    XCSch_Lock(phXCOS); // 锁
X    { ((XC_OSHandle_t)(phXCOS))->Lock = 1; }; 
N    {
N        XC_TaskBasicInit(phTCB);
N        XCList_InitNode(&phTCB->ListNode); // 初始化链表节点
X        { (&phTCB->ListNode)->pNext = (&phTCB->ListNode); (&phTCB->ListNode)->pPrev = (&phTCB->ListNode); }; 
N        phTCB->phXCOS    = phXCOS;         // 保存任务的所属框架句柄
N        phTCB->fTask     = fTask;          // 更新任务入口
N        phTCB->pParam    = pParam;         // 传递给任务的参数
N        phTCB->TaskState = XC_TASK_READY;  // 任务更新状态为就绪
N        XC_InsertTaskToReadyList(phTCB);   // 插入就续表
X        XCList_InsertNodeBefore((phTCB)->phXCOS->pNextReadyNode, &(phTCB)->ListNode);   
N        phXCOS->TaskNum++;                 // 任务数+1
N    }
N    XCSch_Unlock(phXCOS); // 解锁
X    { ((XC_OSHandle_t)(phXCOS))->Lock = 0; }; 
N
N    return (XC_OK);
N}
N
N/**
N * @brief       [用户]任务移除
N * @param[in]   phTCB 协程控制块
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  会从链表中删除,并清空TCB数据;
N *  不可移除自身,移除自身使用"XC_Remove()"函数;
N */
Nvoid XCTask_Remove(XC_TaskHandle_t phTCB)
N{
N    if(phTCB->phXCOS != NULL) {
X    if(phTCB->phXCOS != 0) {
N        // 从表中删除任务
N        XCSch_Lock(phTCB->phXCOS); // 锁
X        { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 1; }; 
N        {
N            XCTask_RemoveTaskNode(phTCB);    // 移除任务节点
X            XCList_Remove(&(phTCB)->ListNode);;    
N            XC_TaskBasicInit(phTCB);         // 基本数据初始化
N            phTCB->phXCOS    = NULL;         // 清除任务的所属框架句柄
X            phTCB->phXCOS    = 0;         
N            phTCB->fTask     = NULL;         // 清除任务入口
X            phTCB->fTask     = 0;         
N            phTCB->pParam    = NULL;         // 清除任务参数
X            phTCB->pParam    = 0;         
N            phTCB->TaskState = XC_TASK_VOID; // 任务状态改为空
N            phTCB->phXCOS->TaskNum--;        // 任务数-1
N        }
N        XCSch_Unlock(phTCB->phXCOS); // 解锁
X        { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 0; }; 
N    }
N}
N
N/**
N * @brief       [用户]任务复位
N * @param[in]   phTCB   协程控制块
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  **不可复位自身(复位自身使用"XC_Reset")**
N *  会清除所有状态(包含挂起),任务复位;
N *  任务将重置到就绪表,然后从头运行;
N *  任务TCB中除了"phXCOS","fTask","Param"其他全部重置;
N */
Nvoid XCTask_Reset(XC_TaskHandle_t phTCB)
N{
N    XCSch_Lock(phTCB->phXCOS); // 锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 1; }; 
N    {
N        XC_TaskBasicInit(phTCB);           // 基本数据初始化
N        phTCB->TaskState = XC_TASK_READY;  // 任务更新状态为就绪
N        XCTask_MoveTaskToReadyList(phTCB); // 任务移动到就绪表
X        XCList_MoveNodeBefore((phTCB)->phXCOS->pNextReadyNode, &(phTCB)->ListNode);; 
N    }
N    XCSch_Unlock(phTCB->phXCOS); // 解锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 0; }; 
N}
N
N/************************************************ 我是分割线 ************************************************/
N/**
N * 任务分步创建相关的用户函数
N *  "XCTask_SetEntry"和"XCS_AddTask"函数需要配合使用;
N *  在"XCTask_SetEntry"设置完成后在XCTask_Addask"添加任务;
N *  注意:不要重复添加任务;
N */
N
N/**
N * @brief       [用户]设置任务入口
N * @param[in]   phTCB   协程任务控制块
N * @param[in]   fTask   任务的函数指针(任务入口)
N * @param[in]   pParam  传递给任务的参数
N * @details
N *  **不可在中断中使用**
N *  只设置任务入口和传递给任务的参数;
N *  一般配合"XCTask_Add"使用;
N */
Nvoid XCTask_SetEntry(XC_TaskHandle_t phTCB, void (*fTask)(XC_TaskHandle_t), void* pParam)
N{
N    phTCB->fTask  = fTask;  // 更新任务入口
N    phTCB->pParam = pParam; // 传递给任务的参数
N}
N
N/**
N * @brief   [用户]添加任务
N * @param   phXCOS  框架句柄
N * @param   phTCB   协程任务控制块
N * @return  XC_Retuen_t
N * @retval  XC_OK :      注册成功
N * @retval  XC_FAIL :    注册失败,任务太多
N * @details
N *  **不可在中断中使用(有链表操作)**
N *  添加的任务必须先调用"XCTask_SetEntry";
N *  设置好任务入口和传递的参数才可添加;
N *  添加后挂载到就绪表;
N */
NXC_Retuen_t XCTask_Add(XC_OSHandle_t phXCOS, XC_TaskHandle_t phTCB)
N{
N    if((phXCOS->TaskNum >= XC_CFG_MAX_TASKS) || (phTCB->fTask == NULL)) {
X    if((phXCOS->TaskNum >= (100)) || (phTCB->fTask == 0)) {
N        return (XC_FAIL);
N    }
N
N    XCSch_Lock(phXCOS); // 锁
X    { ((XC_OSHandle_t)(phXCOS))->Lock = 1; }; 
N    {
N        XC_TaskBasicInit(phTCB);
N        XCList_InitNode(&phTCB->ListNode); // 初始化链表
X        { (&phTCB->ListNode)->pNext = (&phTCB->ListNode); (&phTCB->ListNode)->pPrev = (&phTCB->ListNode); }; 
N        phTCB->phXCOS = phXCOS;            // 保存任务的所属框架句柄
N        XC_InsertTaskToReadyList(phTCB);   // 插入就续表
X        XCList_InsertNodeBefore((phTCB)->phXCOS->pNextReadyNode, &(phTCB)->ListNode);   
N        phXCOS->TaskNum++;                 // 任务数+1
N    }
N    XCSch_Unlock(phXCOS); // 解锁
X    { ((XC_OSHandle_t)(phXCOS))->Lock = 0; }; 
N
N    return (XC_OK);
N}
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 任务通知的用户函数 */
N
N/**
N * @brief       [用户]发送通知
N * @param[in]   phTCB           需要发送通知的任务TCB
N * @param[in]   pNotifyData     通知传递的参数
N * @return      XC_Retuen_t
N * @retval      XC_OK :          通知成功
N * @retval      XC_CONTINUE :    异步操作中
N * @retval      XC_FAIL :        任务不是在等待通知
N * @details
N *  **可在中断中调用**
N *  发送通知,唤醒任务;
N *  多次重复中断:
N *      - 异步操作: 参数是最后一次操作的值;
N *      - 同步操作: 参数是成功操作的值;
N */
NXC_Retuen_t XCTask_NotifySend(XC_TaskHandle_t phTCB, void* pNotifyData)
N{
N    /**
N     * 只有等待通知的任务才能被通知唤醒;
N     */
N    if(phTCB->TaskState != XC_TASK_WAIT_NOTIFY) {
N        return (XC_FAIL);
N    }
N
N    /**
N     *  若是任务运行中或者有链表操作,则异步操作;
N     *  若是此处是"有链表操作",必定是中断调用了;
N     *  这里是异步操作
N     */
N    if(XCSch_GetLockState(phTCB->phXCOS) == 1) { // 判断是否有链表操作
X    if((((XC_OSHandle_t)(phTCB->phXCOS))->Lock) == 1) { 
N        phTCB->pNotifyData = pNotifyData;        // 提前保存传递的通知数据
N        // 触发异步操作
N        phTCB->NotifyTrigger++;            // 通知触发
N        phTCB->phXCOS->TaskSchedTrigger++; // 异步调度触发
N        return (XC_CONTINUE);
N    }
N
N    /** 同步操作,没有操作链表,直接处理 */
N
N    XCSch_Lock(phTCB->phXCOS);           // 锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 1; };           
N    XCTask_MoveTaskToReadyList(phTCB);   // 移动到就绪表
X    XCList_MoveNodeBefore((phTCB)->phXCOS->pNextReadyNode, &(phTCB)->ListNode);;   
N    phTCB->pNotifyData = pNotifyData;    // 传递的通知数据
N    phTCB->WakeType    = XC_WAKE_NOTIFY; // 被通知唤醒
N    phTCB->TaskState   = XC_TASK_READY;  // 任务状态:就绪
N    XCSch_Unlock(phTCB->phXCOS);         // 解锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 0; };         
N
N    return (XC_OK);
N}
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 任务挂起&恢复 */
N
N/**
N * @brief       [用户]任务挂起
N * @param[in]   phTCB   任务控制块
N * @return      XC_Retuen_t
N * @retval      XC_OK :          挂起成功
N * @retval      XC_FAIL:         失败(任务不存在)
N * @retval      XC_CONTINUE :    异步操作中
N * @details
N *  **可在中断中调用**
N *  将任务挂起,**本次任务运行完成后暂停任务**;
N *  挂起可以覆盖任务的所有阻塞状态,优先级最高;
N *  挂起后只能被恢复任务唤醒;
N *  任务唤醒后原先的阻塞将失效,并以"XC_WAKE_RESUME"作为唤醒类型继续运行;
N */
NXC_Retuen_t XCTask_Suspend(XC_TaskHandle_t phTCB)
N{
N    /**
N     *  挂起操作只有在任务存储的时候才能运行;
N     *  挂起操作优先级大于通知处理,在通知处理时可以挂起;
N     *  但是要注意,通知状态下挂起并恢复,会导致通知被唤醒,且"获取唤醒超时"为超时;
N     */
N    if(phTCB->TaskState == XC_TASK_VOID) {
N        return (XC_FAIL);
N    }
N    else if(phTCB->TaskState == XC_TASK_SUSPEND) {
N        return (XC_OK); // 已经被挂起
N    }
N
N    /**
N     *  若是任务运行中或者有链表操作,则异步操作
N     *  若是此处是"有链表操作",必定是中断调用了
N     */
N    if(XCSch_GetLockState(phTCB->phXCOS) == 1) { // 判断是否有链表操作
X    if((((XC_OSHandle_t)(phTCB->phXCOS))->Lock) == 1) { 
N        // 触发异步操作
N        phTCB->StateChangeTrigger++;              // 状态改变触发
N        phTCB->StateChangeType = XC_TASK_SUSPEND; // 状态改变类型:挂起
N        phTCB->phXCOS->TaskSchedTrigger++;        // 异步调度触发
N        return (XC_CONTINUE);
N    }
N
N    /** 同步操作,没有操作链表,直接处理 */
N
N    XCSch_Lock(phTCB->phXCOS);           // 锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 1; };           
N    phTCB->TaskState = XC_TASK_SUSPEND;  // 任务状态:挂起
N    XCTask_MoveTaskToBlockedList(phTCB); // 将任务移动到阻塞表
X    XCList_MoveNodeBefore(&(phTCB)->phXCOS->BlockedList, &(phTCB)->ListNode);; 
N    XCSch_Unlock(phTCB->phXCOS);         // 解锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 0; };         
N
N    return (XC_OK);
N}
N
N/**
N * @brief       [用户]任务挂起恢复
N * @param[in]   phTCB   任务控制块
N * @return      XC_Retuen_t
N * @retval      XC_OK :          恢复成功
N * @retval      XC_CONTINUE :    异步操作中
N * @details
N *  **可在中断中调用**
N *  只能恢复被挂起的任务;
N */
NXC_Retuen_t XCTask_Resume(XC_TaskHandle_t phTCB)
N{
N    // 任务没有被挂起,直接成功
N    if(phTCB->TaskState != XC_TASK_SUSPEND) {
N        return (XC_OK); // 没有被挂起
N    }
N
N    /**
N     *  若是任务运行中或者有链表操作,则异步操作
N     *  若是此处是"有链表操作",必定是中断调用了
N     */
N    if(XCSch_GetLockState(phTCB->phXCOS) == 1) { // 判断是否有链表操作
X    if((((XC_OSHandle_t)(phTCB->phXCOS))->Lock) == 1) { 
N        // 触发异步操作
N        phTCB->StateChangeTrigger++;           // 状态改变触发
N        phTCB->StateChangeType = XC_TASK_VOID; // 状态改变类型:未挂起(恢复)
N        phTCB->phXCOS->TaskSchedTrigger++;     // 异步调度触发
N        return (XC_CONTINUE);
N    }
N
N    /** 同步操作,没有操作链表,直接处理 */
N
N    XCSch_Lock(phTCB->phXCOS);         // 锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 1; };         
N    XCTask_MoveTaskToReadyList(phTCB); // 将任务移动到就绪表
X    XCList_MoveNodeBefore((phTCB)->phXCOS->pNextReadyNode, &(phTCB)->ListNode);; 
N    phTCB->WakeType  = XC_WAKE_RESUME; // 被任务恢复唤醒
N    phTCB->TaskState = XC_TASK_READY;  // 任务状态:就绪
N    XCSch_Unlock(phTCB->phXCOS);       // 解锁
X    { ((XC_OSHandle_t)(phTCB->phXCOS))->Lock = 0; };       
N
N    return (XC_OK);
N}
N
N/************************************************ 我是分割线 ************************************************/
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
