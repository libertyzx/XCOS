N/**
N * @file        XC_List.h
N * @brief       链表操作的声明
N * @author      libertyzx (libertyzx@163.com)
N * @version     2.0
N * @date        2025/11/26
N * **********************************************
N * @copyright   Copyright (c) 2024 libertyzx. All rights reserved.
N * @license     This project is released under the MIT License.
N * **********************************************
N * @details     链表操作的函数声明及类型定义;
N *  本文件中所有类型都是内部使用;用户不要使用;
N * **********************************************
N *  修改日志
N *  - 见"XC_UpdateInfo.md"的更新说明;
N */
N//=== 防重复定义
N#ifndef _XC_List_H_
N#define _XC_List_H_
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**数据类型 */
N
N/**
N * @brief   [内部]双向链表节点类型
N * @details
N *  普通节点和根节点都使用此类型;
N *  根节点只是标记的普通节点;
N *  32位下占8字节;
N */
Ntypedef struct XCListNode_t {
N    struct XCListNode_t* pNext; // 指向下个节点
N    struct XCListNode_t* pPrev; // 指向上个节点
N} XCListNode_t;
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**初始化操作 */
N
N/**
N * @brief       [内部]初始化节点
N * @param[in]   pNode   [XCListNode_t*]需要初始化的节点
N * @details     初始化节点时使用,指向自己,优化为宏;
N */
N#define XCList_InitNode(_pNode)     \
N    {                               \
N        (_pNode)->pNext = (_pNode); \
N        (_pNode)->pPrev = (_pNode); \
N    }
X#define XCList_InitNode(_pNode)         {                                       (_pNode)->pNext = (_pNode);         (_pNode)->pPrev = (_pNode);     }
N
N/**
N * @brief       [内部]初始化链表
N * @param[in]   pList   需要初始化的链表
N * @details     初始化链表时使用
N */
N#define XCList_Init(_pList) XCList_InitNode(_pList)
N
N/************************************************ 我是分割线 ************************************************/
N/**链表节点操作 */
N
N/**
N * @brief       [内部]将新节点插入某节点之前
N * @param[in]   pListNode   [XCListNode_t*]要插入位置的节点
N * @param[in]   pNewNode    [XCListNode_t*]新节点
N * @details     只插入节点;
N */
Nvoid XCList_InsertNodeBefore(XCListNode_t* pListNode, XCListNode_t* pNewNode);
N
N/**
N * @brief       [内部]将节点移动到某个节点之前
N * @param[in]   pDestNode   [XCListNode_t*]目标节点
N * @param[in]   pSrcNode    [XCListNode_t*]需要移动的节点
N * @details
N *  将节点从原先链表中移除,并移动到目标节点之前;
N */
Nvoid XCList_MoveNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcNode);
N
N/**
N * @brief       [内部]从链表中移除一个节点
N * @param[in]   pNode   [XCListNode_t*]需要删除的节点
N * @details     只处理链表节点部分,不影响节点挂载的其他数据;
N */
Nvoid XCList_Remove(XCListNode_t* pNode);
N
N/************************************************ 我是分割线 ************************************************/
N/**基础判断 */
N
N/**
N * @brief       [内部]链表是否有效
N * @param[in]   _pList [XCListNode_t*]链表指针
N * @return      boot
N * @retval      0 : 没有节点
N * @retval      1 : 有节点
N * @details     判断一个链表的是否有效(是否有节点)
N */
N#define XCList_ListValid(_pList)            ((_pList) != ((_pList)->pNext))
N
N/**
N * @brief       [内部]节点是否到达结尾节点
N * @param[in]   _pList  [XCListNode_t*]链表指针
N * @param[in]   _pNode  [XCListNode_t*]节点指针
N * @return      boot
N * @retval      0 : 没有到达结尾节点
N * @retval      1 : 到达结尾节点(节点和链表根地址相同)
N * @details     用于遍历链表时,判断遍历的节点是否到达根节点(既是否结束遍历)
N */
N#define XCList_ReachEndNode(_pList, _pNode) ((_pList) == (_pNode))
N
N/**
N * @brief       [内部]获取链表的开始节点
N * @param[in]   _pList  [XCListNode_t*]链表地址
N * @return      XCListNode_t*   返回节点地址
N * @details     得到当前链表的开始地址
N */
N#define XCList_GetListStartNode(_pList)     ((_pList)->pNext)
N
N/************************************************ 我是分割线 ************************************************/
N/**链表操作 */
N
N/**
N * @brief       [内部]将一个链表全部移动到另个链表的一个节点前
N * @param[in]   pDestNode   需要移入链表的节点(链表将移动到此节点前)
N * @param[in]   pSrcList    需要移动的链表
N * @details  转移完节点后的链表会被清除;
N *  - 注意:不要移动自己;
N */
Nvoid XCList_MoveListToNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcList);
N
N/************************************************ 我是分割线 ************************************************/
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
N#endif
L 22 "..\..\Code\XC_List.c" 2
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**链表节点操作 */
N
N/**
N * @brief       [内部]将新节点插入某节点之前
N * @param[in]   pListNode 要插入位置的节点
N * @param[in]   pNewNode  新节点
N * @details     只插入节点;
N */
Nvoid XCList_InsertNodeBefore(XCListNode_t* pListNode, XCListNode_t* pNewNode)
N{
N    pNewNode->pNext         = pListNode;
N    pNewNode->pPrev         = pListNode->pPrev;
N    pListNode->pPrev->pNext = pNewNode;
N    pListNode->pPrev        = pNewNode;
N}
N
N/**
N * @brief       [内部]将节点移动到某个节点之前
N * @param[in]   pDestNode   目标节点
N * @param[in]   pSrcNode    需要移动的节点
N * @details
N *  将节点从原先链表中移除,并移动到目标节点之前;
N */
Nvoid XCList_MoveNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcNode)
N{
N    // 链接前后两个节点来删除节点
N    pSrcNode->pNext->pPrev = pSrcNode->pPrev;
N    pSrcNode->pPrev->pNext = pSrcNode->pNext;
N
N    // 将新节点插入目标节点之前
N    pSrcNode->pNext         = pDestNode;
N    pSrcNode->pPrev         = pDestNode->pPrev;
N    pDestNode->pPrev->pNext = pSrcNode;
N    pDestNode->pPrev        = pSrcNode;
N}
N
N/**
N * @brief       [内部]从链表中移除一个节点
N * @param[in]   pNode   需要删除的节点
N * @details     只处理链表节点部分,不影响节点挂载的其他数据;
N */
Nvoid XCList_Remove(XCListNode_t* pNode)
N{
N    /* 链接前后两个节点来删除节点*/
N    pNode->pNext->pPrev = pNode->pPrev;
N    pNode->pPrev->pNext = pNode->pNext;
N    /* 初始化删除的节点*/
N    XCList_InitNode(pNode);
X    { (pNode)->pNext = (pNode); (pNode)->pPrev = (pNode); };
N}
N
N/************************************************ 我是分割线 ************************************************/
N/**链表操作 */
N
N/**
N * @brief       [内部]将一个链表全部移动到另个链表的一个节点前
N * @param[in]   pDestNode   需要移入链表的节点(链表将移动到此节点前)
N * @param[in]   pSrcList    需要移动的链表
N * @details
N *  - 转移完节点后的链表会被清除;
N *  - 注意:不要移动自己;
N *  - 移动流程如下:
N *  >   链表X:Root,X1,X2,X3,Root
N *  >   链表Y:Root,Y1,Y2,Y3,Root
N *  >   在链表1节点X2的上面插入链表2;
N *  >   函数为:XCList_MoveListToNodeBefore(&X2,&Y);
N *  >   运行后得到:
N *  >   链表X: Root,X1,Y1,Y2,Y3,X2,X3,Root;
N *  >   链表Y: 被清除;
N *  - 运行表(运行:XCList_MoveListToNodeBefore(&X2,&Y);)
N *  > XR,YR:为根节点; X*,Y*:为节点; P:指向上个节点; N:指向下个节点
N *  > 运行顺序对应代码操作;
N *  | 链表\运行顺序 | 1    | 2    | 3    | 4    | 5         | 最终得到     |
N *  | ---           | ---  | ---  | ---  | ---  | ---       | ---          |
N *  | XR,P=X3,N=X1  |      |      |      |      |           | XR,P=X3,N=X1 |
N *  | X1,P=XR,N=X2  | N=Y1 |      |      |      |           | X1,P=XR,N=Y1 |
N *  | X2,P=X1,N=X3  |      |      |      | P=Y3 |           | X2,P=Y3,N=X3 |
N *  | X3,P=X2,N=XR  |      |      |      |      |           | X3,P=X2,N=XR |
N *  | YR,P=Y3,N=Y1  |      |      |      |      | P=YR,N=YR | YR,P=YR,N=YR |
N *  | Y1,P=YR,N=Y2  |      | P=X1 |      |      |           | Y1,P=X1,N=Y2 |
N *  | Y2,P=Y1,N=Y3  |      |      |      |      |           | Y2,P=Y1,N=Y3 |
N *  | Y3,P=X2,N=YR  |      |      | N=X2 |      |           | Y3,P=X2,N=X2 |
N *  最终2个链表的值:
N *  | 链表X        | 链表Y        |
N *  | ---          | ---          |
N *  | XR,P=X3,N=X1 | YR,P=YR,N=YR |
N *  | X1,P=XR,N=Y1 |              |
N *  | Y1,P=X1,N=Y2 |              |
N *  | Y2,P=Y1,N=Y3 |              |
N *  | Y3,P=X2,N=X2 |              |
N *  | X2,P=Y3,N=X3 |              |
N *  | X3,P=X2,N=XR |              |
N */
Nvoid XCList_MoveListToNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcList)
N{
N    pDestNode->pPrev->pNext = pSrcList->pNext;  //[1]节点上的下,链接到,链表下
N    pSrcList->pNext->pPrev  = pDestNode->pPrev; //[2]链表下的上,链接到,节点上
N    pSrcList->pPrev->pNext  = pDestNode;        //[3]链表上的下,链接到,节点
N    pDestNode->pPrev        = pSrcList->pPrev;  //[4]节点的上,链接到,链表的上
N
N    XCList_Init(pSrcList); //[5]节点移动完成后清除链表
X    { (pSrcList)->pNext = (pSrcList); (pSrcList)->pPrev = (pSrcList); }; 
N}
N
N/************************************************ 我是分割线 ************************************************/
N/*
