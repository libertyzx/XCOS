N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 需要配置的参数
N
N/**
N * @brief   [用户]XCOS基础数据类型
N * @details
N *  默认32位,用于系统滴答计数的数据
N *  一般不用改
N */
N#ifndef XC_Tick_t
N#define XC_Tick_t uint32_t
N#endif
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief   [内部]最大任务数
N * @details
N *  因为是协作式调度,任务数太多会导致每个任务运行卡顿;
N *  这个参数限制最大能注册的任务;
N *  数值范围:10~255;
N *  默认:100
N */
N#ifndef XC_CFG_MAX_TASKS
N#define XC_CFG_MAX_TASKS (100)
N#endif
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief   [内部]系统每秒滴答数(滴答计数频率)
N * @details
N *  单位Hz,是系统最小的时间单位;
N *  最大值是1000000Hz;对应时间是1us;
N *  一般设置1000,对应时间为1ms;
N */
N#ifndef XC_CFG_TICKS_PER_SEC
N#define XC_CFG_TICKS_PER_SEC (1000)
N#endif
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief   [内部]系统滴答计数实现
N * @details
N *  滴答计数是一个累加值,累加时间必须和"XC_CFG_TICKS_PER_SEC"时间一致;
N *  此值会在操作中被读取,作为时间计算的依据;
N *  系统滴答计数可用2种方式使用:
N *--- 方式1:中断累加形式(默认);
N *  用一个变量在定时器中累加,每一个滴答时间则+1;
N *  在此模式下,系统已经定义了一个全局变量"g_SysTickCount"(位于"XC_Sch.c"文件),
N *  并同时在本文件中做了"外部声明全局滴答时间计数";
N *  用户只需要做以下处理即可:
N *      1.创建定时器,按"XC_CFG_TICKS_PER_SEC"计数;
N *      2.在定时器中累加系统滴答计数,即调用"XC_AccSysTickCount()"函数;
N *--- 方式2:计数器形式;
N *  因为协程并不需要中断来切换上下文,所以为了使效率最高可以用一个计数器来做系统滴答计数;
N *  宏"XC_SYS_TICK_COUNT"作为一个计数器的函数的返回值(或其本身寄存器值);
N *  用户需要处理:
N *      1.创建定时器,按"XC_CFG_TICKS_PER_SEC"计数;
N *      2.将计数值作为"XC_SYS_TICK_COUNT"的指向;
N *  注意:
N *      计数器必须是32位计数器;
N *      宏"XC_SYS_TICK_COUNT"会频繁只读调用,注意寄存器读取效率;
N */
N#ifndef XC_SYS_TICK_COUNT
N
N#define _XC_SysTickIntIncMode_            // [默认]以中断递增的模式形式
Nextern volatile XC_Tick_t g_SysTickCount; // 外部声明全局滴答时间计数
Xextern volatile uint32_t g_SysTickCount; 
N#define XC_SYS_TICK_COUNT g_SysTickCount  // 调用滴答时间计数
N
N#endif
N
