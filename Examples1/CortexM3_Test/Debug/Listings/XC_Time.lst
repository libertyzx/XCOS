N/**
N * @file        XC_List.h
N * @brief       链表操作的声明
N * @author      libertyzx (libertyzx@163.com)
N * @version     2.0
N * @date        2025/11/26
N * **********************************************
N * @copyright   Copyright (c) 2024 libertyzx. All rights reserved.
N * @license     This project is released under the MIT License.
N * **********************************************
N * @details     链表操作的函数声明及类型定义;
N *  本文件中所有类型都是内部使用;用户不要使用;
N * **********************************************
N *  修改日志
N *  - 见"XC_UpdateInfo.md"的更新说明;
N */
N//=== 防重复定义
N#ifndef _XC_List_H_
N#define _XC_List_H_
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**数据类型 */
N
N/**
N * @brief   [内部]双向链表节点类型
N * @details
N *  普通节点和根节点都使用此类型;
N *  根节点只是标记的普通节点;
N *  32位下占8字节;
N */
Ntypedef struct XCListNode_t {
N    struct XCListNode_t* pNext; // 指向下个节点
N    struct XCListNode_t* pPrev; // 指向上个节点
N} XCListNode_t;
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**初始化操作 */
N
N/**
N * @brief       [内部]初始化节点
N * @param[in]   pNode   [XCListNode_t*]需要初始化的节点
N * @details     初始化节点时使用,指向自己,优化为宏;
N */
N#define XCList_InitNode(_pNode)     \
N    {                               \
N        (_pNode)->pNext = (_pNode); \
N        (_pNode)->pPrev = (_pNode); \
N    }
X#define XCList_InitNode(_pNode)         {                                       (_pNode)->pNext = (_pNode);         (_pNode)->pPrev = (_pNode);     }
N
N/**
N * @brief       [内部]初始化链表
N * @param[in]   pList   需要初始化的链表
N * @details     初始化链表时使用
N */
N#define XCList_Init(_pList) XCList_InitNode(_pList)
N
N/************************************************ 我是分割线 ************************************************/
N/**链表节点操作 */
N
N/**
N * @brief       [内部]将新节点插入某节点之前
N * @param[in]   pListNode   [XCListNode_t*]要插入位置的节点
N * @param[in]   pNewNode    [XCListNode_t*]新节点
N * @details     只插入节点;
N */
Nvoid XCList_InsertNodeBefore(XCListNode_t* pListNode, XCListNode_t* pNewNode);
N
N/**
N * @brief       [内部]将节点移动到某个节点之前
N * @param[in]   pDestNode   [XCListNode_t*]目标节点
N * @param[in]   pSrcNode    [XCListNode_t*]需要移动的节点
N * @details
N *  将节点从原先链表中移除,并移动到目标节点之前;
N */
Nvoid XCList_MoveNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcNode);
N
N/**
N * @brief       [内部]从链表中移除一个节点
N * @param[in]   pNode   [XCListNode_t*]需要删除的节点
N * @details     只处理链表节点部分,不影响节点挂载的其他数据;
N */
Nvoid XCList_Remove(XCListNode_t* pNode);
N
N/************************************************ 我是分割线 ************************************************/
N/**基础判断 */
N
N/**
N * @brief       [内部]链表是否有效
N * @param[in]   _pList [XCListNode_t*]链表指针
N * @return      boot
N * @retval      0 : 没有节点
N * @retval      1 : 有节点
N * @details     判断一个链表的是否有效(是否有节点)
N */
N#define XCList_ListValid(_pList)            ((_pList) != ((_pList)->pNext))
N
N/**
N * @brief       [内部]节点是否到达结尾节点
N * @param[in]   _pList  [XCListNode_t*]链表指针
N * @param[in]   _pNode  [XCListNode_t*]节点指针
N * @return      boot
N * @retval      0 : 没有到达结尾节点
N * @retval      1 : 到达结尾节点(节点和链表根地址相同)
N * @details     用于遍历链表时,判断遍历的节点是否到达根节点(既是否结束遍历)
N */
N#define XCList_ReachEndNode(_pList, _pNode) ((_pList) == (_pNode))
N
N/**
N * @brief       [内部]获取链表的开始节点
N * @param[in]   _pList  [XCListNode_t*]链表地址
N * @return      XCListNode_t*   返回节点地址
N * @details     得到当前链表的开始地址
N */
N#define XCList_GetListStartNode(_pList)     ((_pList)->pNext)
N
N/************************************************ 我是分割线 ************************************************/
N/**链表操作 */
N
N/**
N * @brief       [内部]将一个链表全部移动到另个链表的一个节点前
N * @param[in]   pDestNode   需要移入链表的节点(链表将移动到此节点前)
N * @param[in]   pSrcList    需要移动的链表
N * @details  转移完节点后的链表会被清除;
N *  - 注意:不要移动自己;
N */
Nvoid XCList_MoveListToNodeBefore(XCListNode_t* pDestNode, XCListNode_t* pSrcList);
N
N/************************************************ 我是分割线 ************************************************/
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N//=== 文件结束
N#endif
