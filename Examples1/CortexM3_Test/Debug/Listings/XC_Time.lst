L 21 "..\..\code\include\Internal/XC_TimeInternal.h" 2
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**
N * 滴答计数频率转换
N * "XC_CFG_TICKS_PER_SEC"在"XC_Config.h"文件定义;
N */
N
N/**
N * (XC_CFG_TICKS_PER_SEC <= 1000),表示时基单位是1ms到1000ms
N */
N#if (XC_CFG_TICKS_PER_SEC <= 1000)
X#if ((1000) <= 1000)
N
N#define _XC_TICK_PERIOD_MS    (1000 / XC_CFG_TICKS_PER_SEC) // 系统滴答计数时基(单位:ms)
N#define _XC_TICK_PERIOD_US    (_XC_TICK_PERIOD_MS * 1000)   // 系统滴答计数时基(单位:us)
N
N/**
N *  将时间转换成Tick(1个时间是多少Tick)
N *  注意:使用"XCTime_UsToTicks"时,时间误差会非常大,tick是ms级的,us时间处理按1个tick处理;
N */
N#define XCTime_UsToTicks(_t)  (((_t) + _XC_TICK_PERIOD_MS * 1000 - 1) / (_XC_TICK_PERIOD_MS * 1000)) /*(t)us 转换成Tick*/
N#define XCTime_MsToTicks(_t)  (((_t) + _XC_TICK_PERIOD_MS - 1) / _XC_TICK_PERIOD_MS)                 /*(t)ms 转换成Tick*/
N#define XCTime_SecToTicks(_t) ((_t) * XC_CFG_TICKS_PER_SEC)                                          /*(t)s  转换成Tick*/
N
N/**将Tick转换成时间(1个tick等于多少个时间)*/
N#define XCTime_TicksToUs(_c)  ((_c) * _XC_TICK_PERIOD_MS * 1000) /*(c)转换成us*/
N#define XCTime_TicksToMs(_c)  ((_c) * _XC_TICK_PERIOD_MS)        /*(c)转换成ms*/
N#define XCTime_TicksToSec(_c) ((_c) / XC_CFG_TICKS_PER_SEC)      /*(c)转换成s*/
N
N/**
N *  (XC_CFG_TICKS_PER_SEC <= 1000000),表示时基单位是1us到999us
N */
N#elif (XC_CFG_TICKS_PER_SEC <= 1000000)
X#elif ((1000) <= 1000000)
S
S#define _XC_TICK_PERIOD_US    (1000000 / XC_CFG_TICKS_PER_SEC)                       // 系统滴答计数时基(单位:us)
S
S/*将时间转换成Tick(1个时间是多少Tick)*/
S#define XCTime_UsToTicks(_t)  (((_t) + _XC_TICK_PERIOD_US - 1) / _XC_TICK_PERIOD_US) /*(t)us 转换成Tick*/
S#define XCTime_MsToTicks(_t)  ((_t) * XC_CFG_TICKS_PER_SEC)                          /*(t)ms 转换成Tick*/
S#define XCTime_SecToTicks(_t) (XCTime_MsToTicks(_t) * 1000)                          /*(t)s  转换成Tick*/
S
S/**将Tick转换成时间(1个tick等于多少个时间)*/
S#define XCTime_TicksToUs(_c)  ((_c) * _XC_TICK_PERIOD_US)                            /*(c)转换成us*/
S#define XCTime_TicksToMs(_c)  ((_c) / XC_CFG_TICKS_PER_SEC)                          /*(c)转换成ms*/
S#define XCTime_TicksToSec(_c) (XCTime_TicksToMs(_c) / 1000)                          /*(c)转换成s*/
S
S#else
S#error "系统每秒滴答数[XC_CFG_TICKS_PER_SECd]设置错误!"
N#endif
N
