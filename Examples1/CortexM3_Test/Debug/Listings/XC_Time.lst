L 18 "..\..\Code\XC_Time.c" 2
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 全局变量 */
N
N// 是中断累加模式,则定义一个全局变量
N#ifdef _XC_SysTickIntIncMode_
Nvolatile XC_Tick_t g_SysTickCount = 0; // 用户系统Tick
Xvolatile uint32_t g_SysTickCount = 0; 
N#endif
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 死循环操作 */
N
N/**
N * @brief       [用户]死循环延时Tick个计数
N * @param[in]   DelayTick   需要延时的Tick数
N * @details     while判断死延时
N */
Nvoid XCTime_BlockDelay(XC_Tick_t DelayTick)
Xvoid XCTime_BlockDelay(uint32_t DelayTick)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick();
X    Tick = (g_SysTickCount);
N    while(!XCTime_CheckTimeout(Tick, DelayTick));
X    while(!(((g_SysTickCount) - (Tick)) >= (DelayTick)));
N}
N
N/**
N * @brief       [用户]死循环延时ms
N * @param[in]   Delay_ms    需要延时的ms数
N * @details     while判断死延时
N */
Nvoid XCTime_BlockDelayMs(XC_Tick_t Delay_ms)
Xvoid XCTime_BlockDelayMs(uint32_t Delay_ms)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick();
X    Tick = (g_SysTickCount);
N    while(!XCTime_CheckTimeout(Tick, XCTime_MsToTicks(Delay_ms)));
X    while(!(((g_SysTickCount) - (Tick)) >= ((((Delay_ms) + (1000 / (1000)) - 1) / (1000 / (1000))))));
N}
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief       [用户]获取剩下多少Tick
N * @param[in]   LastTick        上个记录的Tick
N * @param[in]   CompareTick     等待到达的Tick时间
N * @return      XC_Tick_t        从"LastTick"开始,离"CompareTick"还差多少个Tick,返回0表示到达或者早已到达;
N * @details     获取当前Tick离设定的值还有多少个Tick;
N */
NXC_Tick_t XCTime_GetRemain(XC_Tick_t LastTick, XC_Tick_t CompareTick)
Xuint32_t XCTime_GetRemain(uint32_t LastTick, uint32_t CompareTick)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick(); // 当前Tick
X    Tick = (g_SysTickCount); 
N
N    if((Tick - LastTick) >= CompareTick) {
N        return (0);
N    }
N    return (CompareTick - (Tick - LastTick));
N}
N
N/**
N * @brief       [用户]获取运行了多少Tick
N * @param[in]   LastTick    上个记录的Tick
N * @param[in]   CompareTick 等待到达的Tick时间
N * @return      XC_Tick_t    从"LastTick"开始,到"CompareTick"个Tick已经运行了多少Tick,返回"CompareTick"表示已经运行完成或者早已运行完成;
N * @details     获取当前Tick到设定的值,已经运行了多少个Tick;
N */
NXC_Tick_t XCTime_GetElapsed(XC_Tick_t LastTick, XC_Tick_t CompareTick)
Xuint32_t XCTime_GetElapsed(uint32_t LastTick, uint32_t CompareTick)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick(); // 当前Tick
X    Tick = (g_SysTickCount); 
N
N    if((Tick - LastTick) >= CompareTick) {
N        return (CompareTick);
N    }
N    return (Tick - LastTick);
N}
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N
N/**
N * @brief       [用户]获取剩下多少Tick
N * @param[in]   tTime       "XC_TimerTick_t"类型定义的时间数据;
N * @return      XC_Tick_t    返回余下Tick,返回0表示到达或者早已到达
N * @details     [扩展]从上次调用更新计算,获取当前Tick离设定的值还有多少个Tick;
N */
NXC_Tick_t XCTime_TimerGetRemain(XC_TimerTick_t tTime)
Xuint32_t XCTime_TimerGetRemain(XC_TimerTick_t tTime)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick(); // 当前Tick
X    Tick = (g_SysTickCount); 
N
N    if((Tick - tTime.TickCount) >= tTime.WaitCount) {
N        return (0);
N    }
N    return (tTime.WaitCount - (Tick - tTime.TickCount));
N}
N
N/**
N * @brief       [用户]获取运行了多少Tick
N * @param[in]   tTime       "XC_TimerTick_t"类型定义的时间数据;
N * @return      XC_Tick_t    返回已经运行的Tick,若等于"tTime.WaitCount",表示时间到达或早已到达;
N * @details     [扩展]从上次调用更新计算,获取当前Tick到设定的值已经运行了多少个Tick;
N */
NXC_Tick_t XCTime_TimerGetElapsed(XC_TimerTick_t tTime)
Xuint32_t XCTime_TimerGetElapsed(XC_TimerTick_t tTime)
N{
N    XC_Tick_t Tick;
X    uint32_t Tick;
N    Tick = XCTime_GetTick();
X    Tick = (g_SysTickCount);
N
N    if((Tick - tTime.TickCount) >= tTime.WaitCount) {
N        return (tTime.WaitCount);
N    }
N    return (Tick - tTime.TickCount);
N}
N
