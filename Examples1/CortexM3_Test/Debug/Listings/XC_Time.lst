N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 获取基础时间 */
N
N/**
N * @brief       [用户]获取系统Tick最小时间(单位:us)
N * @return      int32_t     返回当前系统嘀嗒计数(Tick)最小时间(单位:us);
N * @details     即是一次计数过去了多少时间;
N */
N#define XCTime_GetTickUnit() (_XC_TICK_PERIOD_US)
N
N/**
N * @brief       [用户]获取系统Tick
N * @return      XC_Tick_t    返回当前系统嘀嗒计数(Tick)值;
N * @details     获取的是一个全局变量
N */
N#define XCTime_GetTick()     (XC_SYS_TICK_COUNT)
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N *  系统嘀嗒计数处理;
N *  在"XC_SYS_TICK_COUNT"配置为默认状态下有效;
N */
N
N#ifdef _XC_SysTickIntIncMode_
N
N/**
N * @brief   [用户]递增系统Tick
N * @details 在中断中调用,XC_CFG_TICKS_PER_SECond"频率计数;
N */
N#define XCTime_TickInc()  \
N    {                     \
N        g_SysTickCount++; \
N    }
X#define XCTime_TickInc()      {                             g_SysTickCount++;     }
N
N/**
N * @brief   [用户]设置系统Tick
N * @param[in]   _Tick   设置的Tick
N * @details
N *  特殊情况下使用,如休眠唤醒后重新设置系统滴答时间计数;
N */
N#define XCTime_TickSet(_Tick)     \
N    {                             \
N        g_SysTickCount = (_Tick); \
N    }
X#define XCTime_TickSet(_Tick)         {                                     g_SysTickCount = (_Tick);     }
N
N#endif
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**
N * 基础时间比较
N *
N *  使用方式(例程):
N *  - 允许出现"Tick"溢出,溢出后时间计算仍然是对的;
N *  - 这里时间计数限制是:延时等待时间+每次查询Tick是否到达时间,不能超过设置的类型值大小;
N *  ```c
N *  XC_Tick_t Lc;
N *  XC_Tick_t Cache32;
N *  Lc  = XCTime_GetTick();      //得到当前系统Tick
N *  while(1){
N *      if(XCTime_CheckTimeout(Lc, 1000)){
N *          //等待>=1000个Tick后会运行这里;
N *      }
N *      Cache32 = XCTime_GetRemain(Lc,1000);     //从Lc开始,离1000个Tick还差多少个Tick
N *      Cache32 = XCTime_GetElapsed(Lc,1000);        //从Lc开始,到1000个Tick已经运行了多少Tick
N *      if(XCTime_CheckTimeoutMs(Lc, 700){
N *          //等待>=700ms后会运行这里;
N *      }
N *  }
N *  ```
N * ---
N *  注:在时间处理上不要用以下方式处理,在Tick溢出后会出错;
N *  ```c
N *  XC_Tick_t Lct;
N *  Lct = XCTime_GetTick() + 100;           //获取系统Tick+100;
N *  while(1){
N *      if(XCTime_GetTick() >= (Lct)){      //得到Tick+100后运行;
N *          //等待超过100个Tick后运行;
N *      }
N *  }
N *  ```
N */
N
N/**
N * @brief       [用户]比较Tick是否到达设定值
N * @param[in]   _Lc     上个记录的Tick
N * @param[in]   _c      需要比较的Tick个数
N * @return      boor    1:时间到达;0:时间没有到达;
N * @details     判断是否运行了"_c"个Tick,用于判断时间是否到达;
N */
N#define XCTime_CheckTimeout(_Lc, _c)    ((XCTime_GetTick() - (_Lc)) >= (_c))
N
N/**
N * @brief       [用户]比较时间是否到达设定值(单位:ms)
N * @param[in]   _Lc     上个记录的Tick
N * @param[in]   _t      需要比较时间
N * @return      boor    1:时间到达;0:时间没有到达;
N * @details     判断是否运行了"_t"个时间,用于判断时间是否到达;
N */
N#define XCTime_CheckTimeoutMs(_Lc, _t)  (XCTime_CheckTimeout((_Lc), XCTime_MsToTicks(_t)))
N
N/**
N * @brief       [用户]比较时间是否到达设定值(单位:s)
N * @param[in]   _Lc     上个记录的Tick
N * @param[in]   _t      需要比较时间
N * @return      boor    1:时间到达;0:时间没有到达;
N * @details     判断是否运行了"_t"个时间,用于判断时间是否到达;
N */
N#define XCTime_CheckTimeoutSec(_Lc, _t) (XCTime_CheckTimeout((_Lc), XCTime_SecToTicks(_t)))
N
N/************************************************ 我是分割线 ************************************************/
N
N/**
N * @brief       [用户]获取剩下多少Tick
N * @param[in]   LastTick        上个记录的Tick
N * @param[in]   CompareTick     等待到达的Tick时间
N * @return      XC_Tick_t        从"LastTick"开始,离"CompareTick"还差多少个Tick,返回0表示到达或者早已到达;
N * @details     获取当前Tick离设定的值还有多少个Tick;
N */
NXC_Tick_t XCTime_GetRemain(XC_Tick_t LastTick, XC_Tick_t CompareTick);
Xuint32_t XCTime_GetRemain(uint32_t LastTick, uint32_t CompareTick);
N
N/**
N * @brief       [用户]获取运行了多少Tick
N * @param[in]   LastTick    上个记录的Tick
N * @param[in]   CompareTick 等待到达的Tick时间
N * @return      XC_Tick_t    从"LastTick"开始,到"CompareTick"个Tick已经运行了多少Tick,返回"CompareTick"表示已经运行完成或者早已运行完成;
N * @details     获取当前Tick到设定的值,已经运行了多少个Tick;
N */
NXC_Tick_t XCTime_GetElapsed(XC_Tick_t LastTick, XC_Tick_t CompareTick);
Xuint32_t XCTime_GetElapsed(uint32_t LastTick, uint32_t CompareTick);
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/**
N *  扩展时间处理
N *  相比基础时间处理,扩展时间处理增加了数据类型,简化处理;
N *  使用方式(例程):
N *  - "XC_TimerTick_t"类型由2个变量组成,简化"时间处理1"的操作;
N *  - 允许出现"Tick"溢出,溢出后时间计算仍然是对的;
N *  - 这里时间计数限制是:延时等待时间+每次查询Tick是否到达时间,不能超过设置的类型值大小;
N *  ```c
N *  XC_TimerTick_t tCount;
N *  XCTime_TimerSetMs(tCount, 100);     //更新比较的Tick值为100ms
N *  while(1){
N *      if(XCTime_TimerCheck(tCount)){
N *          //等待超过100ms后运行;
N *      }
N *  }
N *  ```
N */
N
N/**
N * @brief       [用户]更新需要延时比较的Tick
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @param[in]   _c      更新比较的Tick计数
N * @details     [扩展]更新需要比较或者延时的Tick数
N */
N#define XCTime_TimerSet(_tC, _c)    ((_tC).TickCount = XCTime_GetTick(), (_tC).WaitCount = (_c))
N
N/**
N * @brief       [用户]更新需要延时比较的时间(ms)
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @param[in]   _t      更新比较的时间
N * @details     [扩展]更新需要比较或者延时的时间
N */
N#define XCTime_TimerSetMs(_tC, _t)  XCTime_TimerSet((_tC), XCTime_MsToTicks(_t)) /*更新:_t毫秒*/
N
N/**
N * @brief       [用户]更新需要延时比较的时间(s)
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @param[in]   _t      更新比较的时间
N * @details     [扩展]更新需要比较或者延时的时间
N */
N#define XCTime_TimerSetSec(_tC, _t) XCTime_TimerSet((_tC), XCTime_SecToTicks(_t)) /*更新:_t秒*/
N
N/**
N * @brief       [用户]重复更新上次需要延时比较的时间
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @details     [扩展]重复更新上次需要比较或者延时的时间;
N */
N#define XCTime_TimerRepeat(_tC)     ((_tC).TickCount = XCTime_GetTick())
N
N/**
N * @brief       [用户]判断需要比较或延时的时间是否到达
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @return      boot    1时间达到;0时间没有到达;
N * @details     [扩展]判断需要比较或延时的时间是否到达
N */
N#define XCTime_TimerCheck(_tC)      ((XCTime_GetTick() - ((_tC).TickCount)) >= ((_tC).WaitCount))
N
N/**
N * @brief       [用户]清除类型中所有计数
N * @param[in]   _tC     "XC_TimerTick_t"类型定义的数据;
N * @details     [扩展]"XC_TimerTick_t"类型数据全清零;
N */
N#define XCTime_TimerClr(_tC)        ((_tC).TickCount = 0, (_tC).WaitCount = 0)
N
N/************************************************ 我是分割线 ************************************************/
N/**
N * @brief       [用户]获取剩下多少Tick
N * @param[in]   tTime       "XC_TimerTick_t"类型定义的时间数据;
N * @return      XC_Tick_t    返回余下Tick,返回0表示到达或者早已到达
N * @details     [扩展]从上次调用更新计算,获取当前Tick离设定的值还有多少个Tick;
N */
NXC_Tick_t XCTime_TimerGetRemain(XC_TimerTick_t tTime);
Xuint32_t XCTime_TimerGetRemain(XC_TimerTick_t tTime);
N
N/**
N * @brief       [用户]获取运行了多少Tick
N * @param[in]   tTime       "XC_TimerTick_t"类型定义的时间数据;
N * @return      XC_Tick_t    返回已经运行的Tick,若等于"tTime.WaitCount",表示时间到达或早已到达;
N * @details     从上次调用更新计算,获取当前Tick到设定的值已经运行了多少个Tick;
N */
NXC_Tick_t XCTime_TimerGetElapsed(XC_TimerTick_t tTime);
Xuint32_t XCTime_TimerGetElapsed(XC_TimerTick_t tTime);
N
N/**
N * @brief       [用户]获取运行了多少ms
N * @param[in]   tTime       "XC_TimerTick_t"类型定义的时间数据;
N * @return      XC_Tick_t    返回已经运行的ms,若等于"tTime.WaitCount",表示时间到达或早已到达;
N * @details     [扩展]从上次调用更新计算,获取当前Tick到设定的值已经运行了多少个Tick;
N */
N#define XCTime_TimerGetElapsedMs(_tC) XCTime_TicksToMs(XCTime_TimerGetElapsed(_tC)) // 获取运行了多少ms
N
N/*
N ************************************************************************************************************|
N ************************************************ 我是分割线 ************************************************|
N ************************************************************************************************************|
N */
N/** 死循环延时 */
N
N/**
N * @brief       [用户]死循环延时Tick个计数
N * @param[in]   DelayTick   需要延时的Tick数
N * @details     while判断死延时
N */
Nvoid XCTime_BlockDelay(XC_Tick_t DelayTick);
Xvoid XCTime_BlockDelay(uint32_t DelayTick);
N
N/**
N * @brief       [用户]死循环延时ms
N * @param[in]   Delay_ms    需要延时的ms数
N * @details     while判断死延时
N */
Nvoid XCTime_BlockDelayMs(XC_Tick_t Delay_ms);
Xvoid XCTime_BlockDelayMs(uint32_t Delay_ms);
N
