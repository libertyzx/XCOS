+/** O3: 待唤醒任务表(中断只登记, 主循环落地) */
+
+/**
+ * @brief       [内部]登记待唤醒任务(O3)
+ * @param[in]   phXCOS 框架句柄
+ * @param[in]   phTCB  需要唤醒的任务
+ * @return      XC_Return_t
+ * @retval      XC_OK   : 已登记
+ * @retval      XC_FAIL : 表满(调用方置 PendScan 走整表扫描兜底)
+ * @details
+ *  单生产者写 WakeTail、单消费者写 WakeHead, 均为单字节读/写 => 无需锁、无需关中断;
+ *  只写TCB指针到表中, 不触碰任何链表 => 可在中断中调用;
+ */
+XC_Return_t XC_Sch_WakePush(XC_OSHandle_t phXCOS, XC_TaskHandle_t phTCB)
+{
+    uint8_t NextTail = (uint8_t)((phXCOS->WakeTail + 1U) % XC_CFG_WAKE_QUEUE);
+
+    if(NextTail == phXCOS->WakeHead) {
+        return (XC_FAIL); // 表满
+    }
+    phXCOS->WakeQueue[phXCOS->WakeTail] = phTCB;
+    phXCOS->WakeTail                    = NextTail;
+    return (XC_OK);
+}
+
+/**
+ * @brief       [内部]待唤醒任务落地(O3: 主循环)
+ * @param[in]   phXCOS 框架句柄
+ * @details
+ *  O(K)排空待唤醒表: 按TCB指针直接搬入就绪表(O(1), 不依赖目标当前在哪张表);
+ *  仅在"仍在等待 && 有通知 && 非挂起/非移除"时落地, 陈旧项直接丢弃;
+ *  表满溢出过(PendScan)则回退整表扫描兜底;
+ */
+static void XC_Sch_WakeSched(XC_OSHandle_t phXCOS)
+{
+    XC_TaskHandle_t phTCB;
+
+    if(phXCOS->PendScan != 0U) {
+        phXCOS->PendScan = 0U;     // 先清后扫: 扫描期间中断再置位 => 下轮再扫, 不丢
+        XC_Sch_EventSched(phXCOS); // 整表扫描兜底(现有 WAKEUP_NOTIFY)
+        return;
+    }
+    while(phXCOS->WakeHead != phXCOS->WakeTail) {
+        phTCB            = phXCOS->WakeQueue[phXCOS->WakeHead];
+        phXCOS->WakeHead = (uint8_t)((phXCOS->WakeHead + 1U) % XC_CFG_WAKE_QUEUE);
+        if((phTCB->NotifyState == (uint8_t)XC_NOTIFY_WAIT) &&
+           (phTCB->NotifyPending != 0U) &&
+           (phTCB->TaskState != (uint8_t)XC_TASK_SUSPEND) &&
+           (phTCB->TaskState != (uint8_t)XC_TASK_VOID)) {
+            phTCB->NotifyPending = 0U;
+            XC_Task_MoveToReadyList(phTCB); // O(1): 按TCB搬表
+            phTCB->NotifyState = XC_NOTIFY_WAKEUP;
+            phTCB->TaskState   = XC_TASK_READY;
+        }
+    }
+}
